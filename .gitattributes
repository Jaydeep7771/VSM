# Normalise line endings: LF in the repository, native in the working copy.
* text=auto eol=lf

# Binary assets — never touch these
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Keep diffs of the lockfile collapsed in reviews
package-lock.json linguist-generated=true -diff

# The archived original design is reference material, not project source
design-source/** linguist-vendored=true
